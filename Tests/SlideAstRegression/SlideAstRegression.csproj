<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- This harness compiles player and editor sources that are written for
         compilers with nullable annotations off, so their nullability warnings
         are not defects in their own context. Suppressed here to keep the build
         output readable: a run that prints warnings every time is a run whose
         output stops being read. -->
    <NoWarn>$(NoWarn);CS0649;CS8629;CS8602;CS8603;CS8618;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/MajdataCore/AlphaCommandBoundary.cs" />
