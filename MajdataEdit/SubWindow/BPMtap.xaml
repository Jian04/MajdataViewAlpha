<Window x:Class="MajdataEdit.BPMtap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BPM" Height="520" Width="370" MinWidth="300" WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="TempoHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            <Setter Property="Background" Value="{DynamicResource ButtonsBackground}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource WindowBackground}">
    <StackPanel Margin="10">
    <Grid Height="142">
        <Button x:Name="Tap_Button" Content="Tap" Height="100"
                Margin="19,10,19,0" VerticalAlignment="Top"
                FontSize="18" Background="{DynamicResource ButtonsBackground}"
                Foreground="{DynamicResource ButtonForeground}" ClickMode="Press"
                Template="{DynamicResource DarkButton}" Click="Tap_Button_Click" />
        <Button x:Name="Reset_Button" Content="Reset" Height="18"
                Margin="19,115,19,0" VerticalAlignment="Top"
                FontSize="11" Background="{DynamicResource ButtonsBackground}"
                Foreground="{DynamicResource ButtonForeground}"
                Template="{DynamicResource DarkButton}" Click="Reset_Button_Click" />


    </Grid>
    <StackPanel x:Name="DetectionPanel" />
    </StackPanel>
    </ScrollViewer>

</Window>
