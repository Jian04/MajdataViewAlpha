<Window x:Class="MajdataEdit.EditorSettingPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture="zh-CN"
        lex:ResxLocalizationProvider.DefaultAssembly="MajdataEdit"
        lex:ResxLocalizationProvider.DefaultDictionary="Langs"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackground}"
        Title="{lex:Loc Key=EditorSetting}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Topmost="True"
        Loaded="Window_Loaded" Closing="Window_Closing" Height="Auto">
    <Window.Resources>

    </Window.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  MaxHeight="720" Padding="0,0,4,0">
    <Grid Margin="5,5,5,5">
        <Grid.Resources>
            <Style TargetType="{x:Type Label}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <EventSetter Event="PreviewMouseWheel" Handler="ComboBox_PreviewMouseWheel" />
                <Setter Property="Template" Value="{DynamicResource DarkComboBox}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                <Setter Property="Background" Value="{DynamicResource ButtonsBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MenuSeparator}" />
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="Height" Value="26" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="Height" Value="26" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Background" Value="{DynamicResource ButtonsBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="Template" Value="{DynamicResource DarkButton}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                <Setter Property="Background" Value="{DynamicResource ButtonsBackground}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="100*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0"
               Content="{lex:Loc Key=EditorLanguage}" />
        <ComboBox x:Name="LanguageComboBox"
                  Grid.Row="0" Grid.Column="1"
                  SelectionChanged="LanguageComboBox_SelectionChanged">
            <ComboBoxItem>中文</ComboBoxItem>
            <ComboBoxItem>English</ComboBoxItem>
            <ComboBoxItem>日本語</ComboBoxItem>
        </ComboBox>

        <Label Grid.Row="1" Grid.Column="0"
               Content="{lex:Loc Key=RenderMode}" />
        <ComboBox x:Name="RenderModeComboBox"
                  Grid.Row="1" Grid.Column="1"
                  SelectionChanged="RenderModeComboBox_OnSelectionChanged">
            <ComboBoxItem Content="{lex:Loc Key=RenderModeHW}" />
            <ComboBoxItem Content="{lex:Loc Key=RenderModeSW}" />
        </ComboBox>

        <Label Grid.Row="2" Grid.Column="0"
               Content="{lex:Loc Key=AssetsSection}" />
        <Border Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Padding="7"
                CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource ButtonsBackground}"
                Background="{DynamicResource EditorBackground}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{lex:Loc Key=DefaultFolder}" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource ButtonForeground}" />
                    <ComboBox x:Name="SkinComboBox" Grid.Column="1" Margin="0"
                              SelectionChanged="SkinComboBox_SelectionChanged" />
                </Grid>
                <StackPanel x:Name="SkinGroupList" />
            </StackPanel>
        </Border>

        <Label Grid.Row="3" Grid.Column="0"
               Content="{lex:Loc Key=ChartRefreshDelay}" />
        <TextBox x:Name="ChartRefreshDelay"
                 Grid.Row="3" Grid.Column="1"
                 Text="1000" />

        <Label Grid.Row="4" Grid.Column="0"
               Content="{lex:Loc Key=InnerBrightness}" />
        <TextBox x:Name="InnerViewerCover"
                 Grid.Row="4" Grid.Column="1"
                 Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                 Text="0.6" />

        <Label Grid.Row="5" Grid.Column="0"
               Content="{lex:Loc Key=OuterBrightness}" />
        <TextBox x:Name="OuterViewerCover"
                 Grid.Row="5" Grid.Column="1"
                 Text="0.6" />

        <Label Grid.Row="6" Grid.Column="0"
               Content="{lex:Loc Key=NoteSpeed}" />
        <TextBox x:Name="ViewerSpeed"
                 Grid.Row="6" Grid.Column="1"
                 Text="7.5"
                 LostKeyboardFocus="SpeedTextBox_LostKeyboardFocus" />

        <Label Grid.Row="7" Grid.Column="0"
               Content="{lex:Loc Key=TouchSpeed}" />
        <TextBox x:Name="ViewerTouchSpeed"
                 Grid.Row="7" Grid.Column="1"
                 Text="7.5"
                 LostKeyboardFocus="SpeedTextBox_LostKeyboardFocus" />

        <Label Grid.Row="8" Grid.Column="0"
               Content="{lex:Loc Key=StarSpeed}" />
        <TextBox x:Name="StarSpeed"
                 Grid.Row="8" Grid.Column="1"
                 Text="0.0"
                 LostKeyboardFocus="SpeedTextBox_LostKeyboardFocus" />

        <Label Grid.Row="9" Grid.Column="0"
               Content="{lex:Loc Key=BackgroundFitMode}" />
        <ComboBox x:Name="BackgroundFitMode"
                  Grid.Row="9" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=BackgroundFitHeight}" />
            <ComboBoxItem Content="{lex:Loc Key=BackgroundFitWidth}" />
        </ComboBox>

        <Label Grid.Row="10" Grid.Column="0"
               Content="{lex:Loc Key=OverallTheme}" />
        <ComboBox x:Name="ThemeComboBox"
                  Grid.Row="10" Grid.Column="1"
                  DisplayMemberPath="displayName"
                  SelectionChanged="ThemeComboBox_SelectionChanged" />

        <Label Grid.Row="11" Grid.Column="0"
               Content="{lex:Loc Key=WindowBackground}" />
        <ComboBox x:Name="EditorBackgroundStyle"
                  Grid.Row="11" Grid.Column="1"
                  SelectionChanged="EditorBackgroundStyle_SelectionChanged">
            <ComboBoxItem Content="{lex:Loc Key=DefaultOption}" />
            <ComboBoxItem Content="CiRCLE PLUS" />
            <ComboBoxItem Content="CiRCLE" />
        </ComboBox>

        <Label Grid.Row="12" Grid.Column="0"
               Content="{lex:Loc Key=IntroBackground}" />
        <ComboBox x:Name="ViewIntroStyle"
                  Grid.Row="12" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=DefaultOption}" />
            <ComboBoxItem Content="CiRCLE PLUS" />
            <ComboBoxItem Content="CiRCLE" />
        </ComboBox>

        <Label Grid.Row="13" Grid.Column="0"
               Content="{lex:Loc Key=EditorFont}" />
        <ComboBox x:Name="EditorFontPreset"
                  Grid.Row="13" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=OriginalStyle}" />
            <ComboBoxItem Content="Cascadia Mono / JetBrains Mono" />
            <ComboBoxItem Content="Cascadia Code" />
            <ComboBoxItem Content="Microsoft YaHei UI" />
            <ComboBoxItem Content="Noto Sans SC" />
            <ComboBoxItem Content="NSimSun" />
            <ComboBoxItem Content="DengXian" />
            <ComboBoxItem Content="Noto Serif SC" />
            <ComboBoxItem Content="Global Monospace" />
            <ComboBoxItem Content="Aileron" />
            <ComboBoxItem Content="Allerta" />
        </ComboBox>

        <Label Grid.Row="14" Grid.Column="0"
               Content="{lex:Loc Key=EditorFontSize}" />
        <TextBox x:Name="EditorFontSize"
                 Grid.Row="14" Grid.Column="1"
                 Text="12"
                 LostKeyboardFocus="FontSizeTextBox_LostKeyboardFocus" />

        <Label Grid.Row="15" Grid.Column="0"
               Content="{lex:Loc Key=ViewDisplayFont}" />
        <ComboBox x:Name="ViewDisplayFont" Grid.Row="15" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=OriginalStyle}" />
            <ComboBoxItem Content="Cascadia Mono / JetBrains Mono" />
            <ComboBoxItem Content="Cascadia Code" />
            <ComboBoxItem Content="Microsoft YaHei UI" />
            <ComboBoxItem Content="Noto Sans SC" />
            <ComboBoxItem Content="NSimSun" />
            <ComboBoxItem Content="DengXian" />
            <ComboBoxItem Content="Noto Serif SC" />
            <ComboBoxItem Content="Global Monospace" />
            <ComboBoxItem Content="Aileron" />
            <ComboBoxItem Content="Allerta" />
        </ComboBox>

        <Label Grid.Row="16" Grid.Column="0"
               Content="{lex:Loc Key=SongInfoCard}" />
        <ComboBox x:Name="SongDetailStyle"
                  Grid.Row="16" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=OriginalStyle}" />
            <ComboBoxItem Content="{lex:Loc Key=OfficialStyleCover}" />
        </ComboBox>

        <StackPanel Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="Collapsed">
            <CheckBox x:Name="EditorLightTheme" VerticalAlignment="Center" />
            <Label Content="{lex:Loc Key=EditorLightMode}" />
        </StackPanel>

        <Label Grid.Row="17" Grid.Column="0"
               Content="{lex:Loc Key=ComboDisplay}" />
        <ComboBox x:Name="ComboDisplay"
                  Grid.Row="17" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayNone}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayCombo}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayScoreClassic}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayAccClassic}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayAccDownClassic}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayAccDeluxe}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayAccDownDeluxe}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayScoreDeluxe}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayCScoreDedeluxe}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayCScoreDownDedeluxe}" />
        </ComboBox>

        <Label Grid.Row="18" Grid.Column="0"
               Content="{lex:Loc Key=PlayMethod}" />
        <ComboBox x:Name="PlayMethod"
                  Grid.Row="18" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=PlayMethodClassic}" />
            <ComboBoxItem Content="{lex:Loc Key=PlayMethodDJAuto}" />
            <ComboBoxItem Content="{lex:Loc Key=PlayMethodRandom}" />
            <ComboBoxItem Content="{lex:Loc Key=PlayMethodDisabled}" />
        </ComboBox>

        <Label Grid.Row="18" Grid.Column="0"
            Content="{lex:Loc Key=SyntaxDisplay}" VerticalAlignment="Top" Visibility="Collapsed" />
        <ComboBox x:Name="SyntaxCheckLevel"
            Grid.Row="18" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="114,1,0,0" SelectedIndex="1"
            Visibility="Collapsed">
            <ComboBoxItem Content="{lex:Loc Key=SyntaxCheckLevel1}" />
            <ComboBoxItem Content="{lex:Loc Key=SyntaxCheckLevel2}" />
            <ComboBoxItem Content="{lex:Loc Key=SyntaxCheckLevel3}" />
        </ComboBox>


        <StackPanel Grid.Row="19" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" >
            <CheckBox x:Name="SmoothSlideAnime" VerticalAlignment="Center" />
            <Label
        Content="{lex:Loc Key=EnableSmoothSlideAnime}" />
            <Label Foreground="{DynamicResource HelperForeground}" Margin="3,0,0,0">
                <Label.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Key=SmoothSlideAnimeTooltip}" />
                        </StackPanel>
                    </ToolTip>
                </Label.ToolTip>
                <TextBlock TextDecorations="Underline" FontSize="12" Text="{lex:Loc Key=WhatsThis}" />
            </Label>
        </StackPanel>
        
        <StackPanel Grid.Row="20" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <CheckBox x:Name="ShowJudgeInfo" VerticalAlignment="Center" />
            <Label Content="{lex:Loc Key=ShowJudgeInfo}" />
            <CheckBox x:Name="ShowComboInfo" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Label Content="{lex:Loc Key=ShowComboInfo}" />
            <CheckBox x:Name="ShowGeneratedMark" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Label Content="{lex:Loc Key=ShowGeneratedMark}" />
        </StackPanel>

        <StackPanel Grid.Row="21" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <CheckBox x:Name="ShowJudgeLine" VerticalAlignment="Center"
                      Checked="ShowJudgeLine_Toggled" Unchecked="ShowJudgeLine_Toggled" />
            <Label Content="{lex:Loc Key=ShowJudgeLine}" />
            <CheckBox x:Name="ShowJudgeText" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Label Content="{lex:Loc Key=ShowJudgeText}" />
            <CheckBox x:Name="ShowJudgeArea" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Label Content="{lex:Loc Key=ShowJudgeArea}" />
        </StackPanel>

        <StackPanel Grid.Row="22" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <CheckBox x:Name="ShowSongDetail" VerticalAlignment="Center" />
            <Label Content="{lex:Loc Key=ShowSongDetail}" />
            <CheckBox x:Name="ShowAllPerfect" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Label Content="{lex:Loc Key=ShowAllPerfect}" />
        </StackPanel>

    </Grid>
    </ScrollViewer>

</Window>
