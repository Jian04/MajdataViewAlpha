<?xml version="1.0" encoding="utf-8"?><Window x:Class="MajdataEdit.EditorSettingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:MajdataEdit" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:lex="http://wpflocalizeextension.codeplex.com" lex:LocalizeDictionary.DesignCulture="zh-CN" lex:ResxLocalizationProvider.DefaultAssembly="MajdataEdit" lex:ResxLocalizationProvider.DefaultDictionary="Langs" mc:Ignorable="d" Background="{DynamicResource WindowBackground}" Title="{lex:Loc Key=EditorSetting}" Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Topmost="True" Loaded="Window_Loaded" Closing="Window_Closing" Height="Auto">
    <Window.Resources>

    </Window.Resources>


    <Grid Background="{DynamicResource PanelBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <Grid x:Name="SettingsFields" Margin="5,5,5,5">
        <Grid.Resources>
            <Style TargetType="{x:Type Label}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="5,0,8,0" />
                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value></Setter>
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <EventSetter Event="PreviewMouseWheel" Handler="ComboBox_PreviewMouseWheel" />
                <Setter Property="Template" Value="{DynamicResource DarkComboBox}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                <Setter Property="Background" Value="{DynamicResource ButtonsBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MenuSeparator}" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Height" Value="30" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Height" Value="30" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Background" Value="{DynamicResource ButtonsBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="Template" Value="{DynamicResource DarkButton}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                <Setter Property="Background" Value="{DynamicResource ButtonsBackground}" />
            </Style>
            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Template" Value="{DynamicResource DarkCheck}" />
                <Setter Property="ContentTemplate">
                    <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="4,7,0,7" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105" />
            <ColumnDefinition Width="100*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="{lex:Loc Key=EditorLanguage}" />
        <ComboBox x:Name="LanguageComboBox" Grid.Row="0" Grid.Column="1" SelectionChanged="LanguageComboBox_SelectionChanged">
            <ComboBoxItem>中文</ComboBoxItem>
            <ComboBoxItem>English</ComboBoxItem>
            <ComboBoxItem>日本語</ComboBoxItem>
        </ComboBox>

        <Label Grid.Row="1" Grid.Column="0" Content="{lex:Loc Key=RenderMode}" />
        <ComboBox x:Name="RenderModeComboBox" Grid.Row="1" Grid.Column="1" SelectionChanged="RenderModeComboBox_OnSelectionChanged">
            <ComboBoxItem Content="{lex:Loc Key=RenderModeHW}" />
            <ComboBoxItem Content="{lex:Loc Key=RenderModeSW}" />
        </ComboBox>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,6" Padding="0" CornerRadius="5" BorderThickness="0" Background="{DynamicResource PanelBackground}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{lex:Loc Key=DefaultFolder}" Margin="5,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource ButtonForeground}" />
                    <ComboBox x:Name="SkinComboBox" Grid.Column="1" Margin="0" SelectionChanged="SkinComboBox_SelectionChanged" />
                </Grid>
                <StackPanel x:Name="SkinGroupList" />
            </StackPanel>
        </Border>

        <Label Grid.Row="6" Grid.Column="0" Content="{lex:Loc Key=ChartRefreshDelay}" />
        <TextBox x:Name="ChartRefreshDelay" Grid.Row="6" Grid.Column="1" Text="1000" />

        <Label Grid.Row="7" Grid.Column="0" Content="{lex:Loc Key=InnerBrightness}" />
        <TextBox x:Name="InnerViewerCover" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Stretch" Text="0.6" />

        <Label Grid.Row="8" Grid.Column="0" Content="{lex:Loc Key=OuterBrightness}" />
        <TextBox x:Name="OuterViewerCover" Grid.Row="8" Grid.Column="1" Text="0.6" />

        <Label Grid.Row="9" Grid.Column="0" Content="{lex:Loc Key=NoteSpeed}" />
        <TextBox x:Name="ViewerSpeed" Grid.Row="9" Grid.Column="1" Text="7.5" LostKeyboardFocus="SpeedTextBox_LostKeyboardFocus" />

        <Label Grid.Row="10" Grid.Column="0" Content="{lex:Loc Key=TouchSpeed}" />
        <TextBox x:Name="ViewerTouchSpeed" Grid.Row="10" Grid.Column="1" Text="7.5" LostKeyboardFocus="SpeedTextBox_LostKeyboardFocus" />

        <Label Grid.Row="11" Grid.Column="0" Content="{lex:Loc Key=StarSpeed}" />
        <TextBox x:Name="StarSpeed" Grid.Row="11" Grid.Column="1" Text="0.0" LostKeyboardFocus="SpeedTextBox_LostKeyboardFocus" />

        <Label Grid.Row="13" Grid.Column="0" Content="{lex:Loc Key=BackgroundFitMode}" />
        <ComboBox x:Name="BackgroundFitMode" Grid.Row="13" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=BackgroundFitHeight}" />
            <ComboBoxItem Content="{lex:Loc Key=BackgroundFitWidth}" />
        </ComboBox>

        <Label Grid.Row="14" Grid.Column="0" Content="{lex:Loc Key=OverallTheme}" />
        <ComboBox x:Name="ThemeComboBox" Grid.Row="14" Grid.Column="1" SelectionChanged="ThemeComboBox_SelectionChanged" />

        <local:VisualStylePicker x:Name="EditorBackgroundStyle" Grid.Row="3" Grid.ColumnSpan="2"
            Title="{lex:Loc Key=WindowBackground}" IsEnabled="False" Opacity="0.45" SelectionChanged="EditorBackgroundStyle_SelectionChanged" />
        <local:VisualStylePicker x:Name="ViewIntroStyle" Grid.Row="4" Grid.ColumnSpan="2"
            Title="{lex:Loc Key=IntroBackground}" Kind="ViewBackground" SelectionChanged="ViewIntroStyle_SelectionChanged" />

        <Label Grid.Row="15" Grid.Column="0" Content="{lex:Loc Key=EditorFont}" />
        <ComboBox x:Name="EditorFontPreset" Grid.Row="15" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=OriginalStyle}" />
            <ComboBoxItem Content="Cascadia Mono / JetBrains Mono" />
            <ComboBoxItem Content="Cascadia Code" />
            <ComboBoxItem Content="Microsoft YaHei UI" />
            <ComboBoxItem Content="Noto Sans SC" />
            <ComboBoxItem Content="NSimSun" />
            <ComboBoxItem Content="DengXian" />
            <ComboBoxItem Content="Noto Serif SC" />
            <ComboBoxItem Content="Global Monospace" />
            <ComboBoxItem Content="Aileron" />
            <ComboBoxItem Content="Allerta" />
        </ComboBox>

        <Label Grid.Row="16" Grid.Column="0" Content="{lex:Loc Key=EditorFontSize}" />
        <StackPanel Grid.Row="16" Grid.Column="1">
            <TextBox x:Name="EditorFontSize" Text="12" LostKeyboardFocus="FontSizeTextBox_LostKeyboardFocus" />
        </StackPanel>

        <Label Grid.Row="17" Grid.Column="0" Content="{lex:Loc Key=ViewDisplayFont}" />
        <ComboBox x:Name="ViewDisplayFont" Grid.Row="17" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=OriginalStyle}" />
            <ComboBoxItem Content="Cascadia Mono / JetBrains Mono" />
            <ComboBoxItem Content="Cascadia Code" />
            <ComboBoxItem Content="Microsoft YaHei UI" />
            <ComboBoxItem Content="Noto Sans SC" />
            <ComboBoxItem Content="NSimSun" />
            <ComboBoxItem Content="DengXian" />
            <ComboBoxItem Content="Noto Serif SC" />
            <ComboBoxItem Content="Global Monospace" />
            <ComboBoxItem Content="Aileron" />
            <ComboBoxItem Content="Allerta" />
        </ComboBox>

        <Label Grid.Row="18" Grid.Column="0" Content="{lex:Loc Key=SongInfoCard}" />
        <StackPanel Grid.Row="18" Grid.Column="1">
        <ComboBox x:Name="SongDetailStyle">
            <ComboBoxItem Content="{lex:Loc Key=OriginalStyle}" />
            <ComboBoxItem Content="{lex:Loc Key=OfficialStyleCover}" />
        </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="Collapsed">
            <CheckBox x:Name="EditorLightTheme" VerticalAlignment="Center" />
            <Label Content="{lex:Loc Key=EditorLightMode}" />
        </StackPanel>

        <Label Grid.Row="19" Grid.Column="0" Content="{lex:Loc Key=ComboDisplay}" />
        <ComboBox x:Name="ComboDisplay" Grid.Row="19" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayNone}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayCombo}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayScoreClassic}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayAccClassic}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayAccDownClassic}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayAccDeluxe}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayAccDownDeluxe}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayScoreDeluxe}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayCScoreDedeluxe}" />
            <ComboBoxItem Content="{lex:Loc Key=ComboDisplayCScoreDownDedeluxe}" />
        </ComboBox>

        <Label Grid.Row="20" Grid.Column="0" Content="{lex:Loc Key=PlayMethod}" />
        <ComboBox x:Name="PlayMethod" Grid.Row="20" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=PlayMethodClassic}" />
            <ComboBoxItem Content="{lex:Loc Key=PlayMethodDJAuto}" />
            <ComboBoxItem Content="{lex:Loc Key=PlayMethodRandom}" />
            <ComboBoxItem Content="{lex:Loc Key=PlayMethodDisabled}" />
        </ComboBox>

        <Label Grid.Row="20" Grid.Column="0" Content="{lex:Loc Key=SyntaxDisplay}" VerticalAlignment="Top" Visibility="Collapsed" />
        <ComboBox x:Name="SyntaxCheckLevel" Grid.Row="20" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="114,1,0,0" SelectedIndex="1" Visibility="Collapsed">
            <ComboBoxItem Content="{lex:Loc Key=SyntaxCheckLevel1}" />
            <ComboBoxItem Content="{lex:Loc Key=SyntaxCheckLevel2}" />
            <ComboBoxItem Content="{lex:Loc Key=SyntaxCheckLevel3}" />
        </ComboBox>


        <Label x:Name="PetSelectorLabel" Grid.Row="21" Grid.Column="0" Content="默认桌宠" />
        <ComboBox x:Name="PetComboBox" Grid.Row="21" Grid.Column="1"
                  SelectionChanged="PetComboBox_SelectionChanged" />
        <Label Grid.Row="22" Grid.Column="0" Content="{lex:Loc Key=ViewTopLeftDisplay}" />
        <ComboBox x:Name="ViewTopLeftDisplayMode" Grid.Row="22" Grid.Column="1">
            <ComboBoxItem Content="{lex:Loc Key=ViewTopLeftOff}" />
            <ComboBoxItem Content="{lex:Loc Key=ViewTopLeftFps}" />
            <ComboBoxItem Content="{lex:Loc Key=ViewTopLeftBpm}" />
            <ComboBoxItem Content="{lex:Loc Key=ViewTopLeftMeter}" />
            <ComboBoxItem Content="{lex:Loc Key=ViewTopLeftSubdivision}" />
        </ComboBox>

        <!-- Keep every display option on its own aligned row. -->
        <Label Grid.Row="23" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0,0,0,0" Content="{lex:Loc Key=DisplaySection}" />
        <Border Grid.Row="24" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6" Padding="0" BorderThickness="0" BorderBrush="{DynamicResource ButtonsBackground}" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ShowJudgeText" Content="{lex:Loc Key=ShowJudgeText}" />
                <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ShowMineHitFeedback" Content="{lex:Loc Key=ShowMineHitFeedback}" />
                <CheckBox Grid.Row="2" Grid.Column="0" x:Name="ShowJudgeInfo" Content="{lex:Loc Key=ShowJudgeInfo}" />
                <CheckBox Grid.Row="3" Grid.Column="0" x:Name="ShowComboInfo" Content="{lex:Loc Key=ShowComboInfo}" />
                <CheckBox Grid.Row="4" Grid.Column="0" x:Name="ShowSongDetail" Content="{lex:Loc Key=ShowSongDetail}" />
                <CheckBox Grid.Row="5" Grid.Column="0" x:Name="ShowAllPerfect" Content="{lex:Loc Key=ShowAllPerfect}" />
                <CheckBox Grid.Row="6" Grid.Column="0" x:Name="ClipBackgroundToRing" Content="{lex:Loc Key=ClipBackgroundToRing}" />
                <CheckBox Grid.Row="7" Grid.Column="0" x:Name="ShowGeneratedMark" Content="{lex:Loc Key=ShowGeneratedMark}" />
                <CheckBox Grid.Row="8" Grid.Column="0" x:Name="SmoothSlideAnime" Content="{lex:Loc Key=EnableSmoothSlideAnime}" ToolTip="{lex:Loc Key=SmoothSlideAnimeTooltip}" />
                <CheckBox Grid.Row="9" Grid.Column="0" x:Name="DisableAutomaticSongDetailRefresh" Content="{lex:Loc Key=DisableAutomaticSongDetailRefresh}">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Opacity" Value="0.45" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SongDetailStyle}" Value="1">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
            <local:VisualStylePicker x:Name="JudgeLineStylePicker" Title="{lex:Loc Key=JudgeLineStyle}" Kind="JudgeLine" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
    </Grid>

</Window>
