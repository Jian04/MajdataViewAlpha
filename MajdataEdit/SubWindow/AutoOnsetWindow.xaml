<Window x:Class="MajdataEdit.AutoOnsetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture="zh-CN"
        lex:ResxLocalizationProvider.DefaultAssembly="MajdataEdit"
        lex:ResxLocalizationProvider.DefaultDictionary="Langs"
        Title="{lex:Loc AutoOnset}"
        Width="500" Height="455"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Closing="AutoOnsetWindow_Closing"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{lex:Loc AutoOnsetDescription}"
                   Foreground="{DynamicResource ButtonForeground}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <Grid Grid.Row="1" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="BPM"
                       Foreground="{DynamicResource ButtonForeground}"
                       VerticalAlignment="Center" />
            <TextBox x:Name="BpmBox"
                     Grid.Column="1"
                     Height="28"
                     VerticalContentAlignment="Center"
                     ToolTip="{lex:Loc AutoOnsetBpmTip}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="First"
                       Foreground="{DynamicResource ButtonForeground}"
                       VerticalAlignment="Center" />
            <TextBox x:Name="FirstBox"
                     Grid.Column="1"
                     Height="28"
                     VerticalContentAlignment="Center"
                     ToolTip="{lex:Loc AutoOnsetFirstTip}" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{lex:Loc Difficulty}"
                       Foreground="{DynamicResource ButtonForeground}"
                       VerticalAlignment="Center" />
            <TextBox x:Name="DifficultyBox"
                     Grid.Column="1"
                     Height="28"
                     VerticalContentAlignment="Center"
                     ToolTip="{lex:Loc AutoOnsetDifficultyTip}" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{lex:Loc AutoOnsetThreshold}"
                       Foreground="{DynamicResource ButtonForeground}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
                <ComboBox x:Name="ThresholdPresetBox" Height="28" SelectedIndex="0">
                    <ComboBoxItem Content="{lex:Loc AutoOnsetThresholdRecommended}" Tag="0.550000011920929" />
                    <ComboBoxItem Content="{lex:Loc AutoOnsetThresholdDense}" Tag="0.50" />
                    <ComboBoxItem Content="{lex:Loc AutoOnsetThresholdSparse}" Tag="0.60" />
                    <ComboBoxItem Content="{lex:Loc AutoOnsetThresholdClean}" Tag="0.65" />
                </ComboBox>
                <TextBlock Text="{lex:Loc AutoOnsetThresholdTip}"
                           Foreground="{DynamicResource HelperForeground}"
                           FontSize="11"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="5"
                Margin="0,14,0,10"
                Padding="10"
                BorderBrush="{DynamicResource HelperForeground}"
                BorderThickness="1"
                CornerRadius="5"
                Background="{DynamicResource ButtonsBackground}">
            <TextBlock Text="{lex:Loc AutoOnsetReplaceWarning}"
                       Foreground="{DynamicResource ButtonForeground}"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="6" VerticalAlignment="Top">
            <ProgressBar x:Name="Progress"
                         Height="5"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource HelperForeground}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       MaxHeight="54" />
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="GenerateButton"
                    Content="{lex:Loc AutoOnsetGenerate}"
                    Width="112"
                    Height="30"
                    IsDefault="True"
                    Click="GenerateButton_Click" />
            <Button x:Name="CancelButton"
                    Content="{lex:Loc Cancel}"
                    Width="82"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
