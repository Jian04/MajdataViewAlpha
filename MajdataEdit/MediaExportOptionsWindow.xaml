<Window x:Class="MajdataEdit.MediaExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="媒体导出设置" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBackground}">
    <Grid Margin="18">
        <Grid.Resources>
            <Style TargetType="ComboBox">
                <Setter Property="Template" Value="{DynamicResource DarkComboBox}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                <Setter Property="Background" Value="{DynamicResource ButtonsBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MenuSeparator}" />
                <Setter Property="Height" Value="28" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Template" Value="{DynamicResource DarkCheck}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Template" Value="{DynamicResource DarkButton}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                <Setter Property="Background" Value="{DynamicResource ButtonsBackground}" />
                <Setter Property="Height" Value="30" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            </Style>
        </Grid.Resources>

        <StackPanel x:Name="VideoOptionsPanel">
            <TextBlock Text="视频导出" FontWeight="Bold" Margin="0,0,0,10" />
            <Button Content="智能导出（不超过 20 MiB）" Click="SmartExport_Click" />
            <TextBlock Text="优先使用 30 fps；体积不足时依次降低分辨率和码率。"
                       Foreground="{DynamicResource HelperForeground}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,6,0,12" />

            <Grid Margin="0,2,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Height="1" Background="{DynamicResource MenuSeparator}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="自定义" Margin="10,0" Foreground="{DynamicResource HelperForeground}" />
                <Border Grid.Column="2" Height="1" Background="{DynamicResource MenuSeparator}" VerticalAlignment="Center" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="分辨率" VerticalAlignment="Center" />
                <ComboBox x:Name="ResolutionBox" Grid.Row="0" Grid.Column="1">
                    <ComboBoxItem Content="最高源分辨率" IsSelected="True" />
                    <ComboBoxItem Content="1080p" />
                    <ComboBoxItem Content="720p" />
                    <ComboBoxItem Content="360p" />
                </ComboBox>
                <TextBlock Grid.Row="1" Text="帧率（fps）" VerticalAlignment="Center" />
                <ComboBox x:Name="FrameRateBox" Grid.Row="1" Grid.Column="1">
                    <ComboBoxItem Content="24" />
                    <ComboBoxItem Content="30" IsSelected="True" />
                    <ComboBoxItem Content="60" />
                    <ComboBoxItem Content="120" />
                </ComboBox>
                <TextBlock Grid.Row="2" Text="码率（kbps）" VerticalAlignment="Center" />
                <ComboBox x:Name="BitrateBox" Grid.Row="2" Grid.Column="1">
                    <ComboBoxItem Content="2000" />
                    <ComboBoxItem Content="4000" />
                    <ComboBoxItem Content="6000" IsSelected="True" />
                    <ComboBoxItem Content="10000" />
                    <ComboBoxItem Content="20000" />
                </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="自定义导出" Width="100" Click="CustomExport_Click" />
                <Button Content="取消" Width="72" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="AudioOptionsPanel" Visibility="Collapsed">
            <TextBlock Text="音频导出" FontWeight="Bold" Margin="0,0,0,10" />
            <CheckBox x:Name="Force44100Box" Content="导出为 44100 Hz" IsChecked="True" />
            <TextBlock Text="关闭后保持 FFmpeg 的默认采样率。"
                       Foreground="{DynamicResource HelperForeground}" FontSize="11" Margin="24,6,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="导出" Width="82" Click="ConfirmAudio_Click" />
                <Button Content="取消" Width="72" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
