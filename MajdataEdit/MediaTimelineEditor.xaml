<UserControl x:Class="MajdataEdit.MediaTimelineEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             AllowDrop="True"
             Drop="Timeline_Drop"
             PreviewKeyDown="Timeline_PreviewKeyDown"
             Background="{DynamicResource EditorBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ButtonsBackground}"
                BorderBrush="{DynamicResource MenuSeparator}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Background="{DynamicResource ButtonsBackground}">
            <DockPanel Margin="6,4" LastChildFill="False">
                <Button Content="← 编辑" Width="62" Margin="0,0,8,0" Click="Close_Click"
                        Template="{DynamicResource DarkButton}" />
                <CheckBox x:Name="SnapCheck" Content="吸附到一拍" IsChecked="True"
                          VerticalAlignment="Center" Margin="2,0,8,0"
                          Foreground="{DynamicResource ButtonForeground}"
                          Background="{DynamicResource ButtonsBackground}"
                          BorderBrush="{DynamicResource MenuSeparator}"
                          Template="{DynamicResource DarkCheck}" />
                <Button Content="切割" Width="44" Margin="0,0,4,0" Click="Split_Click"
                        Template="{DynamicResource DarkButton}" />
                <Button Content="复制" Width="44" Margin="0,0,4,0" Click="Copy_Click"
                        Template="{DynamicResource DarkButton}" />
                <Button Content="粘贴" Width="44" Margin="0,0,4,0" Click="Paste_Click"
                        Template="{DynamicResource DarkButton}" />
                <Button Content="删除" Width="44" Margin="0,0,9,0" Click="Delete_Click"
                        Template="{DynamicResource DarkButton}" />
                <Button Content="导出音频" Width="72" Margin="0,0,4,0" Click="ExportAudio_Click"
                        Template="{DynamicResource DarkButton}" />
                <Button Content="导出视频" Width="72" Margin="0,0,9,0" Click="ExportVideo_Click"
                        Template="{DynamicResource DarkButton}" />
                <TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{DynamicResource ButtonForeground}" />
                <Slider x:Name="ZoomSlider" Minimum="4" Maximum="160" Value="16" Width="124" Height="20"
                        VerticalAlignment="Center"
                        ValueChanged="ZoomSlider_ValueChanged" />
            </DockPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource ButtonsBackground}"
                    BorderBrush="{DynamicResource MenuSeparator}" BorderThickness="0,0,1,0">
                <Canvas x:Name="TrackLabelCanvas" />
            </Border>
            <ScrollViewer x:Name="TimelineScroll" Grid.Column="1"
                          HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False" PreviewMouseWheel="TimelineScroll_PreviewMouseWheel"
                          Background="{DynamicResource ScrollTrack}">
                <Canvas x:Name="TimelineCanvas" Height="190" MinWidth="900"
                        Background="{DynamicResource EditorBackground}"
                        PreviewMouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                        PreviewMouseRightButtonDown="TimelineCanvas_PreviewMouseRightButtonDown"
                        PreviewMouseMove="TimelineCanvas_MouseMove"
                        PreviewMouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp" />
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource ButtonsBackground}"
                BorderBrush="{DynamicResource MenuSeparator}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,0">
                <ProgressBar x:Name="ExportProgress" DockPanel.Dock="Right" Width="150" Height="8"
                             Margin="8,0,0,0" VerticalAlignment="Center" IsIndeterminate="True"
                             Visibility="Collapsed" Foreground="{DynamicResource ScrollThumbHover}"
                             Background="{DynamicResource ScrollTrack}" />
                <TextBlock x:Name="CursorText" Text="播放头 00:00.000" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="拖入音频、视频或图片；图片默认 5 秒，拖动片段两侧可调整时长。"
                           Margin="18,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource HelperForeground}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
