                     Padding="1,5,6,5" FontFamily="Cascadia Mono, JetBrains Mono, Cascadia Code, Consolas" FontWeight="Normal"
                     Foreground="{DynamicResource ButtonForeground}" TextChanged="FumenContent_TextChanged"
                     Margin="102,29,10,96" HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Visible"
                     Grid.ColumnSpan="2"
                     InputMethod.IsInputMethodEnabled="True"
                     ShowLineNumbers="True"
                     WordWrap="False"
                     Background="#FF3A4049"
                     PreviewKeyDown="FumenContent_OnPreviewKeyDown" Grid.Row="1" Grid.Column="1">
            <avalonEdit:TextEditor.ContextMenu>
                <ContextMenu Background="{DynamicResource WindowBackground}"
                             Foreground="{DynamicResource ButtonForeground}"
                             BorderBrush="{DynamicResource MenuSeparator}"
                             BorderThickness="1" Padding="2">
                    <ContextMenu.Template>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer CanContentScroll="True"
                                              Background="Transparent">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <ContextMenu.ItemsPanel>
                        <!-- The default WrapPanel does not guarantee equal row and Separator widths.
                             Width depends on the widest text, causing separator and menu-item mismatches.
                             A vertical StackPanel stretches children horizontally so both widths match exactly. -->
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ContextMenu.ItemsPanel>
                    <ContextMenu.Resources>
                        <!-- Menu Separators resolve through MenuItem.SeparatorStyleKey and ignore normal implicit TargetType styles.
                             This key is required for a full-width separator. -->
                        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
                            <!-- Avoid negative margins: MenuItem Padding affects only content, not outer width.
                                 The Separator's default HorizontalAlignment=Stretch naturally fills the same
                                 ItemsPresenter width as MenuItem. Offsetting Border Padding=2 with negative margins
                                 previously made the separator wider than the menu items. -->
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="UseLayoutRounding" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Separator}">
                                        <Rectangle Height="1" Fill="{DynamicResource MenuSeparator}"
                                                   UseLayoutRounding="True"
                                                   SnapsToDevicePixels="True" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="{x:Type MenuItem}">
                            <!-- Popup menus use a separate visual tree. In release builds, DynamicResource previously failed
                                 to resolve the template, leaving blank menu items and only separators. App.xaml loads before
                                 every window, so StaticResource resolves the template once during parsing. -->
                            <Setter Property="Template" Value="{StaticResource DarkMenuItem}" />
                            <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="{lex:Loc CreateMeasure44}">
                        <MenuItem Header="{lex:Loc MeasureCount1}" Tag="4/4|1" Click="InsertMeasureTemplate_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc MeasureCount2}" Tag="4/4|2" Click="InsertMeasureTemplate_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc MeasureCount3}" Tag="4/4|3" Click="InsertMeasureTemplate_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc MeasureCount4}" Tag="4/4|4" Click="InsertMeasureTemplate_MenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="{lex:Loc CreateMeasure34}">
                        <MenuItem Header="{lex:Loc MeasureCount1}" Tag="3/4|1" Click="InsertMeasureTemplate_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc MeasureCount2}" Tag="3/4|2" Click="InsertMeasureTemplate_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc MeasureCount3}" Tag="3/4|3" Click="InsertMeasureTemplate_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc MeasureCount4}" Tag="3/4|4" Click="InsertMeasureTemplate_MenuItem_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{lex:Loc MirrorSelection}">
                        <MenuItem Header="{lex:Loc MirrorLR}" Click="MirrorLeftRight_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc MirrorUD}" Click="MirrorUpDown_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc Mirror180}" Click="Mirror180_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc Mirror45}" Click="Mirror45_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc MirrorCcw45}" Click="MirrorCcw45_MenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="{lex:Loc FormatSelection}">
                        <MenuItem Header="{lex:Loc HighestDivision}" Click="FormatBrushAuto_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc Division8}" Click="FormatBrush8_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc Division12}" Click="FormatBrush12_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc Division16}" Click="FormatBrush16_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc Division24}" Click="FormatBrush24_MenuItem_Click" />
                        <MenuItem Header="{lex:Loc Division32}" Click="FormatBrush32_MenuItem_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{lex:Loc SearchSelectedInLibrary}"
                              Click="SearchSelectedChartPattern_MenuItem_Click" />
                </ContextMenu>
            </avalonEdit:TextEditor.ContextMenu>
            <avalonEdit:TextEditor.Resources>
                <RoutedUICommand x:Key="PlayAndPause" Text="PlayAndPause" />
                <RoutedUICommand x:Key="SaveFile" Text="SaveFile" />
                <RoutedUICommand x:Key="StopPlaying" Text="StopPlaying" />
                <RoutedUICommand x:Key="SendToView" Text="SendToView" />
                <RoutedUICommand x:Key="IncreasePlaybackSpeed" Text="IncreasePlaybackSpeed" />
                <RoutedUICommand x:Key="DecreasePlaybackSpeed" Text="DecreasePlaybackSpeed" />
                <RoutedUICommand x:Key="Find" Text="Find" />
                <RoutedUICommand x:Key="MirrorLR" Text="MirrorLR" />
                <RoutedUICommand x:Key="MirrorUD" Text="MirrorUD" />
                <RoutedUICommand x:Key="Mirror180" Text="Mirror180" />
                <RoutedUICommand x:Key="Mirror45" Text="Mirror45" />
                <RoutedUICommand x:Key="MirrorCcw45" Text="MirrorCcw45" />
            </avalonEdit:TextEditor.Resources>
            <!--Bindings are dynamicly added via ReadEditorSetting()-->
            <avalonEdit:TextEditor.CommandBindings>
                <CommandBinding Command="{StaticResource PlayAndPause}" CanExecute="PlayAndPause_CanExecute" />
                <CommandBinding Command="{StaticResource SaveFile}" CanExecute="SaveFile_Command_CanExecute" />
                <CommandBinding Command="{StaticResource StopPlaying}" CanExecute="StopPlaying_CanExecute" />
                <CommandBinding Command="{StaticResource SendToView}" CanExecute="SendToView_CanExecute" />
                <CommandBinding Command="{StaticResource IncreasePlaybackSpeed}"
