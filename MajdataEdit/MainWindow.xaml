                <MenuItem Header="{lex:Loc FormatBrush12}" Click="FormatBrush12_MenuItem_Click" />
                <MenuItem Header="{lex:Loc FormatBrush16}" Click="FormatBrush16_MenuItem_Click" />
                <MenuItem Header="{lex:Loc FormatBrush24}" Click="FormatBrush24_MenuItem_Click" />
                <MenuItem Header="{lex:Loc FormatBrush32}" Click="FormatBrush32_MenuItem_Click" />
