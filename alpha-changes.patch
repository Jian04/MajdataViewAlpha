++        private static bool TryValidateInternal(
++            SlidePathData path,
++            bool requireDuration,
++            out string error)
++        {
++            error = string.Empty;
++            if (path == null ||
++                path.segments == null ||
++                path.segments.Count == 0)
++            {
++                error = Diagnose(
++                    "星星没有任何路径段",
++                    "SLIDE PATH IS EMPTY",
++                    path?.source ?? string.Empty);
++                return false;
++            }
