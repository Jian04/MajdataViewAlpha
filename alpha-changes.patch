++                    error = Diagnose(
++                        "星星时长写法错误",
++                        "INVALID SLIDE DURATION",
++                        segment.duration);
++                    return false;
++                }
++                durationCount++;
++            }
++
++            if (!NoteModifierParser.TryParseSlideRuns(
++                    path.headModifiers ?? string.Empty,
++                    modifierRuns,
++                    out _))
++            {
++                error = Diagnose(
++                    "修饰符位置错误：星星主体只能写「b」或「m」，其余修饰符要写在头部",
++                    "INVALID SLIDE MODIFIER POSITION: THE BODY ALLOWS ONLY 'b' OR 'm'",
++                    string.IsNullOrEmpty(path.source)
++                        ? path.headModifiers ?? string.Empty
++                        : path.source);
++                return false;
++            }
++
++            if ((requireDuration || durationCount > 0) &&
++                durationCount != 1 &&
++                durationCount != path.segments.Count)
++            {
++                error = Diagnose(
++                    $"组合星星只能写一个总时长，或每段各写一个时长（现在写了 {durationCount} 个，共 {path.segments.Count} 段）",
