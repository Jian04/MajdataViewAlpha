-        static int[]? FindHSpeedBody(string simaiStr)
-        {
-            //<HS*>
-            simaiStr = simaiStr.Replace(" ", "");
-            List<int> bodyHead = new();
-            List<int> bodyTail = new();
-            int? tagHead = null;
-            int? tagTail = null;            
-            
-            for(int i = 0;i < simaiStr.Length;i++)
-            {
-                if(i + 3 < simaiStr.Length)
-                {
-                    var s = simaiStr[i..(i + 3)];
-                    if(s == "HS*")
-                    {
-                        if (tagHead != null)
-                            return null;
-                        tagHead = i;
-                        tagTail = i + 2;
-                    }
-                }
-                switch(simaiStr[i])
-                {
-                    case '<':
-                        bodyHead.Add(i);
