++    [Flags]
++    public enum NoteModifierFlags
++    {
++        None = 0,
++        Break = 1 << 0,
++        Ex = 1 << 1,
++        Firework = 1 << 2,
++        Mine = 1 << 3,
++        NoHeadWithFade = 1 << 4,
++        NoHeadWithoutFade = 1 << 5,
++        NoHead = NoHeadWithFade | NoHeadWithoutFade,
++        ForceStar = 1 << 6,
++        FakeRotate = 1 << 7
