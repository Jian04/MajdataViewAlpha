++                    path.source);
++                return false;
++            }
++            if (hasTouchSegment &&
++                path.segments.Count > 1 &&
++                durationCount == path.segments.Count)
++            {
++                error = Diagnose(
++                    "TouchSlide 只能写一个总时长，不支持逐段时长",
++                    "TOUCH SLIDE NEEDS ONE TOTAL DURATION, NOT ONE PER SEGMENT",
++                    path.source);
++                return false;
++            }
++            return true;
++        }
