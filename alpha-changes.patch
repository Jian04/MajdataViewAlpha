++        private static AlphaCommandDescriptor BuildScreenEffect(
++            string name,
++            string canonical,
++            bool negatesIntensity,
++            AlphaValueSpec[] arguments,
++            AlphaValueSpec[]? envelopeArguments)
++        {
++            var forms = new List<AlphaArgumentForm>();
