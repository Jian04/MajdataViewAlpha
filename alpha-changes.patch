+    private static void AddOverlayNotes(
+        List<SimaiTimingPoint> mainNotes,
+        IEnumerable<SimaiTimingPoint> overlayNotes)
+    {
+        mainNotes.AddRange(overlayNotes);
+        mainNotes.Sort((left, right) => left.time.CompareTo(right.time));
+    }
