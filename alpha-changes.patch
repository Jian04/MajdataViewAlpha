+    private static void CheckABorrowedTrajectoryIsNeverJudged()
+    {
+        SimaiProcess.ClearData();
+        SimaiProcess.Serialize("(120){4}1~[5-7[8:1]],\nE");
+        var notes = SimaiProcess.notelist[0].getNotes();
+        Assert(notes.Count == 1, $"One note, got {notes.Count}.");
+        var note = notes[0];
+        Assert(
+            note.isTrajectoryOnly && note.isFake &&
+            note.isFakeHead && note.isFakeSlide && note.isSlideNoHead,
+            "A borrowed trajectory has to come out fake on every part and with " +
+            "no head: nothing about it is judged and nothing is dropped at the " +
+            "position it was written at.");
+        Assert(
+            note.noteType == SimaiNoteType.Slide &&
+            note.slidePath.Count == 1 &&
+            note.startPosition == 5,
+            $"The note follows the borrowed path exactly as written, so it starts " +
+            $"where that path starts, got {note.startPosition}.");
+        Assert(
+            note.slideTime > 0d && note.slideStartTime > 0d,
+            $"The borrowed duration has to come along: {note.slideTime}.");
+        SimaiProcess.ClearData();
+
+        // An ordinary slide is untouched by any of this.
+        SimaiProcess.ClearData();
+        SimaiProcess.Serialize("(120){4}1-5[8:1],\nE");
+        var plain = SimaiProcess.notelist[0].getNotes()[0];
+        Assert(
+            !plain.isTrajectoryOnly && !plain.isFake && !plain.isSlideNoHead,
+            "A plain slide must keep its head, its arc and its judgement.");
+        SimaiProcess.ClearData();
+
+        // Shapes whose star is not one star travelling one path are refused with
+        // a message rather than drawn wrongly.
+        foreach (var refused in new[] { "1~[5w7[8:1]]", "1~[A1-A5[8:1]]" })
+            Assert(
+                !NoteExpressionParser.TryParse(refused, out _, out var refusal) &&
+                refusal.Length > 0,
+                $"'{refused}' is not supported yet and has to say so.");
+
+        // The player has to be told, and the arc has to be stopped where every
+        // path through the fade goes: at the one place that sets its opacity.
+        var slide = File.ReadAllText("Assets/Scripts/Notes/SlideDrop.cs");
+        var alphaAt = slide.IndexOf(
+            "private void setSlideBarAlpha(float alpha)", StringComparison.Ordinal);
+        Assert(
+            alphaAt >= 0 &&
+            slide.Substring(alphaAt, 400).Contains("if (isTrajectoryOnly)",
+                StringComparison.Ordinal),
+            "The borrowed arc has to be refused at the single place that sets " +
+            "bar opacity, or some fade path will bring it back.");
+        Assert(
+            File.ReadAllText("Assets/Scripts/JsonDataLoader.cs").Contains(
+                "SliCompo.isTrajectoryOnly = note.isTrajectoryOnly;",
+                StringComparison.Ordinal),
+            "The player never hears about the borrow unless the loader passes it.");
+    }
