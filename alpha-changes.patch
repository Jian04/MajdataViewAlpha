-
-            for(int index = 0;index < bodyStr.Length;index++)
-            {
-                char c = bodyStr[index];
-                if(c == '[')
-                {
-                    bodyHeadCount++;
-                    bodyIndex.Add(index);
-                }
-                else if(c == ']')
-                {
-                    bodyTailCount++;
-                    bodyIndex.Add(index);
-                }
