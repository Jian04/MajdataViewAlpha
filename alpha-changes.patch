++            TouchSlideDrop touchSlide => Mathf.Max(0f, touchSlide.duration),
++            NoteLongDrop longNote => Mathf.Max(0f, longNote.LastFor),
++            _ => 0f
++        };
++        // A judged Hold disappears the moment it ends, so a fake one must not
++        // linger past its tail. Other kinds keep the short miss-window grace.
++        var grace = note is HoldDrop or TouchHoldDrop ? 0f : 0.35f;
++        if (timeProvider.AudioTime > note.time + tailDuration + grace)
++            Destroy(gameObject);
++    }
++}
